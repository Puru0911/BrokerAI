# App
APP_NAME=BrokerAI
ENV=local

# Database
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/brokerai

# LLM orchestration
LLM_PROVIDER=openrouter
LLM_REQUEST_TIMEOUT_SECONDS=30
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
LLM_MODEL=deepseek/deepseek-chat-v3-0324
GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_LLM_MODEL=llama-3.3-70b-versatile
GEMINI_API_KEY=
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
GEMINI_LLM_MODEL=gemini-2.5-flash

# Vector storage / RAG
CHROMA_PERSIST_DIR=./data/chroma
CHROMA_REQUEST_COLLECTION=broker_requests
MATCH_EXPORT_DIR=./data/match_exports
MATCH_EXPORT_AUTO_LIMIT=10
MEDIATION_INITIAL_TIMEOUT_HOURS=48
MEDIATION_NEGOTIATION_TIMEOUT_HOURS=72
MEDIATION_MAX_ACTIVE_PER_REQUEST=1

# Supabase (optional for MVP auth verification on backend)
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
# If you later validate JWTs server-side, set issuer to your Supabase project's issuer URL
SUPABASE_JWT_ISSUER=
SUPABASE_JWT_AUDIENCE=authenticated
