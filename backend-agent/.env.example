# App
APP_NAME=BrokerAI
ENV=local
# Production frontend origin used for OpenRouter HTTP-Referer and CORS fallback.
PUBLIC_APP_URL=http://localhost:3000
# JSON list. Production must include the real HTTPS frontend origin.
CORS_ORIGINS=["http://localhost:3000","http://localhost:3001","http://127.0.0.1:3000","http://127.0.0.1:3001"]
# Shared secret for POST /internal/process-stale (min 16 chars). Required outside local.
INTERNAL_JOB_SECRET=

# Database — shares user_profiles with the original backend; broker data uses new tables.
# Local: direct Postgres. Production: Supabase transaction pooler (port 6543).
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/brokerai
# Supabase pooler TLS. Leave false on macOS/Homebrew (self-signed chain). Set true in prod if CA verify works.
DATABASE_SSL_VERIFY=false

# LLM
LLM_PROVIDER=openrouter
LLM_REQUEST_TIMEOUT_SECONDS=60
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
LLM_MODEL=nvidia/nemotron-3-ultra-550b-a55b:free
OPENROUTER_REASONING_ENABLED=true
OPENROUTER_REASONING_EFFORT=medium
OPENROUTER_REASONING_EXCLUDE=false
GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_LLM_MODEL=llama-3.3-70b-versatile
GEMINI_API_KEY=
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
GEMINI_LLM_MODEL=gemini-2.5-flash

# Vector storage
CHROMA_PERSIST_DIR=./data/chroma
CHROMA_REQUEST_COLLECTION=agent_requests

# Agent
AGENT_MAX_TOOL_STEPS=8
AGENT_MODEL_INVOKE_RETRIES=3
MATCH_TIMEOUT_HOURS=48
MAX_OPEN_MATCHES_PER_REQUEST=1

# Logging (use INFO in production)
LOG_LEVEL=DEBUG
LOG_FILE=logs/brokerai.log

# Auth / storage
# Dashboard: Project Settings → API
#   SUPABASE_URL = Project URL
#   SUPABASE_JWT_SECRET = JWT Secret (legacy HS256 only). New projects sign with ES256;
#   those tokens are verified via JWKS at {SUPABASE_URL}/auth/v1/.well-known/jwks.json
#   Do not use the anon or service_role key as the JWT secret.
#   SUPABASE_SERVICE_ROLE_KEY = service_role (server only)
# Issuer defaults to {SUPABASE_URL}/auth/v1 when left blank.
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_JWT_SECRET=
SUPABASE_JWT_ISSUER=
SUPABASE_JWT_AUDIENCE=authenticated
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=broker-attachments
ATTACHMENT_MAX_BYTES=10000000
ATTACHMENT_MAX_PER_SESSION=20
ATTACHMENT_MAX_PER_CONNECTION=100

# Web Push (optional). Local/dev generates keys into data/vapid.json when unset.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:broker@localhost
VAPID_KEY_PATH=./data/vapid.json
