# App
APP_NAME=BrokerAI
ENV=local

# Database — shares user_profiles with the original backend; broker data uses new tables.
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/brokerai

# LLM
LLM_PROVIDER=openrouter
LLM_REQUEST_TIMEOUT_SECONDS=60
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
LLM_MODEL=nvidia/nemotron-3-ultra-550b-a55b:free
OPENROUTER_REASONING_ENABLED=true
OPENROUTER_REASONING_EFFORT=medium
OPENROUTER_REASONING_EXCLUDE=false
GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_LLM_MODEL=llama-3.3-70b-versatile
GEMINI_API_KEY=
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
GEMINI_LLM_MODEL=gemini-2.5-flash

# Vector storage
CHROMA_PERSIST_DIR=./data/chroma
CHROMA_REQUEST_COLLECTION=agent_requests

# Agent
AGENT_MAX_TOOL_STEPS=8
AGENT_MODEL_INVOKE_RETRIES=3
MATCH_TIMEOUT_HOURS=48
MAX_OPEN_MATCHES_PER_REQUEST=1

# Logging
LOG_LEVEL=DEBUG
LOG_FILE=logs/brokerai.log

# Auth / storage
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_JWT_ISSUER=
SUPABASE_JWT_AUDIENCE=authenticated
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=broker-attachments
ATTACHMENT_MAX_BYTES=10000000
ATTACHMENT_MAX_PER_SESSION=20
ATTACHMENT_MAX_PER_CONNECTION=100

# Web Push (optional). Local/dev generates keys into data/vapid.json when unset.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:broker@localhost
VAPID_KEY_PATH=./data/vapid.json
